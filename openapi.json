ciary"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Beneficiary"}}}, "tags": ["wallets"]}, "delete": {"operationId": "wallets_beneficiaries_delete", "description": "ViewSet for managing beneficiaries.", "parameters": [], "responses": {"204": {"description": ""}}, "tags": ["wallets"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/wallets/deposit/": {"post": {"operationId": "wallets_deposit_create", "description": "View to initiate a deposit into the user's wallet.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["amount"], "type": "object", "properties": {"amount": {"description": "Amount to deposit", "type": "number"}}}}], "responses": {"200": {"description": "Deposit initiated"}, "400": {"description": "Bad Request"}}, "tags": ["wallets"]}, "parameters": []}, "/wallets/deposit/account/": {"get": {"operationId": "wallets_deposit_account_list", "description": "Get or create the virtual deposit account.", "parameters": [], "responses": {"200": {"description": "Virtual account details"}, "500": {"description": "Internal server error"}}, "tags": ["wallets"]}, "parameters": []}, "/wallets/payments/initiate/": {"post": {"operationId": "wallets_payments_initiate_create", "description": "Initiate a payment.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/PaymentInitiation"}}], "responses": {"200": {"description": "Payment initiated"}, "400": {"description": "Bad Request"}}, "tags": ["wallets"]}, "parameters": []}, "/wallets/payments/lookup/": {"post": {"operationId": "wallets_payments_lookup_create", "description": "Lookup user details by phone number.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/UserLookupRequest"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/UserLookupResponse"}}, "404": {"description": "User not found"},