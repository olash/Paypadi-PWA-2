ccessful"}, "400": {"description": "Bad Request"}}, "tags": ["wallets"]}, "parameters": []}, "/wallets/wallet/": {"get": {"operationId": "wallets_wallet_read", "description": "View to retrieve wallet information.", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Wallet"}}}, "tags": ["wallets"]}, "parameters": []}, "/wallets/withdraw/": {"post": {"operationId": "wallets_withdraw_create", "description": "View to initiate a withdrawal from the user's wallet.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/TransferFunds"}}], "responses": {"200": {"description": "Withdrawal completed"}, "400": {"description": "Bad Request"}}, "tags": ["wallets"]}, "parameters": []}}, "definitions": {"DriverPayoutAccount": {"required": ["account_name", "account_number"], "type": "object", "properties": {"id": {"title": "ID", "type": "integer", "readOnly": true}, "account_type": {"title": "Account type", "type": "string", "enum": ["bank_account", "mobile_money"]}, "account_name": {"title": "Account name", "type": "string", "maxLength": 255, "minLength": 1}, "account_number": {"title": "Account number", "type": "string", "maxLength": 50, "minLength": 1}, "bank_name": {"title": "Bank name", "type": "string", "maxLength": 100, "x-nullable": true}, "bank_code": {"title": "Bank code", "type": "string", "maxLength": 20, "x-nullable": true}, "is_primary": {"title": "Is primary", "type": "boolean"}, "is_verified": {"title": "Is verified", "type": "boolean", "readOnly": true}, "created_at": {"title": "Created at", "type": "string", "format": "date-time", "readOnly": true}, "updated_at": {"title": "Updated at", "type": "string", "format": "date-time", "readOnly": true}}}, "DriverProfile": {"type": "object", "properties": {"id": {"title": "ID", "type": "integer", "readOnly": true}, "vehicle_make": {"title": "Vehicle make", "type": "string", "maxLength": 100, "x-nullable": true}, "vehicle_model": {"title": "Vehicle model", "type": "string", "maxLength": 100, "x-nullable": true}, "vehicle_year": {"title": "Vehicle year", "type": "integer", "maximum": 9223372036854775807, "minimum": 0, "x-nullable": true}, "driver_license_number": {"title": "Driver license number", "type": "string", "maxLength": 50, "x-nullable": true}, "driver_license_expiry": {"title": "Driver license expiry", "type": "string", "format": "date", "x-nullable": true}, "license_plate": {"title": "License plate", "type": "string", "maxLength": 20, "x-nullable": true}, "license_front": {"title": "License front", "type": "string", "readOnly": true, "x-nullable": true, "format": "uri"}, "license_back": {"title": "License back", "type": "string", "readOnly": true, "x-nullable": true, "format": "uri"}, "vehicle_registration": {"title": "Vehicle registration", "type": "string", "readOnly": true, "x-nullable": true, "format": "uri"}, "submitted_for_approval": {"title": "Submitted for approval", "type": "boolean"}, "is_approved": {"title": "Is approved", "type": "boolean", "readOnly": true}, "approved_at": {"title": "Approved at", "type": "string", "format": "date-time", "readOnly": true, "x-nullable": true}, "rejection_reason": {"title": "Rejection reason", "type": "string", "readOnly": true, "minLength": 1, "x-nullable": true}, "is_available": {"title": "Is available", "type": "boolean"}, "current_location_lat": {"title": "Current location lat", "type": "string", "format": "decimal", "x-nullable": true}, "current_location_lng": {"title": "Current location lng", "type": "string", "format": "decimal", "x-nullable": true}, "rating": {"title": "Rating", "type": "string", "format": "decimal"}, "total_rides": {"title": "Total rides", "type": "integer", "maximum": 9223372036854775807, "minimum": 0}, "created_at": {"title": "Created at", "type": "string", "format": "date-time", "readOnly": true}, "updated_at": {"title": "Updated at", "type": "string", "format": "date-time", "readOnly": true}}}, "CustomTokenObtainPair"